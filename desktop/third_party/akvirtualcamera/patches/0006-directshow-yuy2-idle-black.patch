+// GpAutoLive modification, GPL-3.0-or-later.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace AkVCam {
+// YUY2 limited-range black: Y0=16, U=128, Y1=16, V=128.
+inline void fillYuy2BlackFrame(std::uint8_t *data, std::size_t bytes) {
+    for (std::size_t index = 0; index < bytes; ++index)
+        data[index] = index % 2 == 0 ? 16 : 128;
+}
+}
