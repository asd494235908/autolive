diff --git a/windows/PlatformUtils/src/yuy2_sample.h b/windows/PlatformUtils/src/yuy2_sample.h
new file mode 100644
index 0000000..d618fdc
--- /dev/null
+++ b/windows/PlatformUtils/src/yuy2_sample.h
@@ -0,0 +1,28 @@
+// GpAutoLive modification, GPL-3.0-or-later.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace AkVCam {
+inline std::size_t packedYuy2SampleBytes(int width, int height) {
+    if (width <= 0 || height <= 0 || width % 2 != 0) return 0;
+    const auto rowBytes = static_cast<std::size_t>(width) * 2;
+    return static_cast<std::size_t>(height) > std::numeric_limits<std::size_t>::max() / rowBytes
+        ? 0 : rowBytes * height;
+}
+
+// VideoFrame uses SIMD-aligned rows. DirectShow YUY2 samples carry only pixels.
+inline bool copyPackedYuy2Sample(std::uint8_t *destination, std::size_t capacity,
+                                const std::uint8_t *source, std::size_t sourceStride,
+                                int width, int height) {
+    const auto rowBytes = static_cast<std::size_t>(width) * 2;
+    const auto bytes = packedYuy2SampleBytes(width, height);
+    if (!bytes || !destination || !source || sourceStride < rowBytes || capacity < bytes)
+        return false;
+    for (int row = 0; row < height; ++row)
+        std::memcpy(destination + row * rowBytes, source + row * sourceStride, rowBytes);
+    return true;
+}
+}
