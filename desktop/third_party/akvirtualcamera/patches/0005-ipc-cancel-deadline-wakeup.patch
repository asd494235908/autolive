 #include "sockets.h"
+#include <algorithm>
+#include <climits>
+#ifndef _WIN32
+#include <fcntl.h>
+#include <errno.h>
+#endif
+
+namespace {
+bool wouldBlock()
+{
+#ifdef _WIN32
+    auto error = WSAGetLastError();
+    return error == WSAEWOULDBLOCK || error == WSAEINPROGRESS;
+#else
+    return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINPROGRESS || errno == EINTR;
+#endif
+}
+
+bool waitReady(SocketType socket, bool writing, AkVCam::Sockets::Deadline deadline,
+               const std::atomic_bool *cancelled)
+{
+    while (!cancelled || !cancelled->load()) {
+        auto remaining = deadline - std::chrono::steady_clock::now();
+        if (remaining <= std::chrono::steady_clock::duration::zero())
+            return false;
+        auto micros = std::min<int64_t>(50000,
+            std::chrono::duration_cast<std::chrono::microseconds>(remaining).count());
+        timeval timeout {0, static_cast<long>(micros)};
+        fd_set ready, errors;
+        FD_ZERO(&ready); FD_SET(socket, &ready);
+        FD_ZERO(&errors); FD_SET(socket, &errors);
+        auto result = select(int(socket + 1), writing? nullptr: &ready,
+                             writing? &ready: nullptr, &errors, &timeout);
+        if (result < 0 || FD_ISSET(socket, &errors))
+            return false;
+        if (result > 0)
+            return !cancelled || !cancelled->load();
+    }
+    return false;
+}
+}
+
+bool AkVCam::Sockets::connect(SocketType socket, const sockaddr *address, int addressSize,
+                              Deadline deadline, const std::atomic_bool *cancelled)
+{
+#ifdef _WIN32
+    u_long nonblocking = 1;
+    if (ioctlsocket(socket, FIONBIO, &nonblocking) != 0)
+        return false;
+#else
+    auto flags = fcntl(socket, F_GETFL, 0);
+    if (flags < 0 || fcntl(socket, F_SETFL, flags | O_NONBLOCK) != 0)
+        return false;
+#endif
+    if (cancelled && cancelled->load())
+        return false;
+    if (::connect(socket, address, addressSize) == 0)
+        return true;
+    if (!wouldBlock() || !waitReady(socket, true, deadline, cancelled))
+        return false;
+    int error = 0;
+#ifdef _WIN32
+    int size = sizeof(error);
+#else
+    socklen_t size = sizeof(error);
+#endif
+    return getsockopt(socket, SOL_SOCKET, SO_ERROR, reinterpret_cast<char *>(&error), &size) == 0
+           && error == 0;
+}
 
