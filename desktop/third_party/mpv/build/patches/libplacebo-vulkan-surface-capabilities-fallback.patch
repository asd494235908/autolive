+                                                                    &surface_caps);
+    if (result == VK_ERROR_UNKNOWN) {
+        PL_WARN(vk, "Extended surface capabilities query failed with "
+                    "VK_ERROR_UNKNOWN, retrying the basic query");
+        VK(vk->GetPhysicalDeviceSurfaceCapabilitiesKHR(vk->physd, p->surf,
