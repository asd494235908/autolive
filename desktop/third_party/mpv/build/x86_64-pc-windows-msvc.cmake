set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)

set(CMAKE_C_COMPILER /opt/llvm/bin/clang-cl)
set(CMAKE_CXX_COMPILER /opt/llvm/bin/clang-cl)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_LINKER lld-link)
set(CMAKE_AR /work/native/bin/llvm-lib)
set(CMAKE_RANLIB /work/native/bin/llvm-ranlib)
set(CMAKE_RC_COMPILER /work/native/bin/llvm-rc)
set(CMAKE_MT /work/native/bin/llvm-mt)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_POLICY_DEFAULT_CMP0091 NEW)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(CMAKE_C_FLAGS_INIT "/MT /Brepro /clang:-ffile-prefix-map=/work=/usr/src/autolive-mpv /imsvc/work/sysroot/msvc/include /imsvc/work/sysroot/ucrt/include /imsvc/work/sysroot/windows-sdk/include/shared /imsvc/work/sysroot/windows-sdk/include/um /imsvc/work/sysroot/windows-sdk/include/winrt")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "/Brepro /libpath:/work/sysroot/msvc/lib/x64 /libpath:/work/sysroot/ucrt/lib/x64 /libpath:/work/sysroot/windows-sdk/lib/um/x64")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${CMAKE_EXE_LINKER_FLAGS_INIT}")

set(CMAKE_FIND_ROOT_PATH /work/prefix /work/sysroot)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
