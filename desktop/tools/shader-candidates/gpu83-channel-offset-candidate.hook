//!PARAM al_channel_offset_percent
//!TYPE float
//!MINIMUM -10.0
//!MAXIMUM 10.0
0.0

//!HOOK MAIN
//!BIND HOOKED
//!DESC AutoLive Phase 3A floating-point channel offset candidate
//!WIDTH HOOKED.w
//!HEIGHT HOOKED.h
//!WHEN al_channel_offset_percent

vec4 hook() {
    vec4 source_color = HOOKED_tex(HOOKED_pos);
    float channel_offset = clamp(al_channel_offset_percent, -10.0, 10.0) / 100.0;
    if (channel_offset == 0.0) {
        return source_color;
    }

    vec3 shifted_rgb = clamp(
        vec3(
            source_color.r + channel_offset,
            source_color.g,
            source_color.b - channel_offset
        ),
        vec3(0.0),
        vec3(1.0)
    );
    return vec4(shifted_rgb, source_color.a);
}
