{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autolive-desktop-core",
  "version": "0.1.0",
  "identifier": "com.gepin.autolive.desktop.core",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev --host 0.0.0.0 --port 5173",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:"
      },
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "autolive-desktop-core",
        "width": 1100,
        "height": 820,
        "backgroundColor": "#ffffff",
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "runtime-resources.json",
      "embedded-runtime-resources",
      "portaudio/portaudio_x64.dll",
      "portaudio/LICENSE.txt",
      "portaudio/README.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
