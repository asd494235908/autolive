{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "autoLive Desktop",
  "version": "0.1.0",
  "identifier": "com.gepin.autolive.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev --host 0.0.0.0 --port 5173",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "script-src": "'self' http://localhost:5173",
        "style-src": "'self' 'unsafe-inline' http://localhost:5173",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:"
      },
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "autoLive Desktop",
        "width": 1100,
        "height": 820,
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": ["binaries/ffmpeg*", "binaries/ffprobe*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
