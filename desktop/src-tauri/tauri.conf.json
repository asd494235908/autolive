{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GpAutoLive",
  "version": "0.1.0",
  "identifier": "com.gepin.autolive.desktop.core",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev --host 0.0.0.0 --port 5173",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      },
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "media-src": "'self' asset: http://asset.localhost blob:"
      },
      "capabilities": [
        "default",
        "final-effect"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "GpAutoLive",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 680,
        "decorations": false,
        "backgroundColor": "#0b0b0f",
        "resizable": true,
        "fullscreen": false,
        "visible": true,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "resources": [
      "runtime-resources.json",
      "embedded-runtime-resources",
      "akvirtualcamera",
      "portaudio/portaudio_x64.dll",
      "portaudio/LICENSE.txt",
      "portaudio/README.md",
      "ambient/low-level-room-tone.wav",
      "resources/shaders/gpu83.hook",
      "ambient/LICENSE.txt",
      "signalsmith-stretch/LICENSE.txt",
      "signalsmith-linear/LICENSE.txt",
      "speexdsp/LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
