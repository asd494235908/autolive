{
  "identifier": "default",
  "description": "Main window capability for local playback, dialogs and allowlisted control-plane HTTP.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "main-commands",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://admin.example.com/**" }
      ]
    }
  ]
}
