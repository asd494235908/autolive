{
  "name": "admin-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "api:generate": "openapi-typescript ../接口契约/openapi.yaml -o src/api/openapi.generated.ts",
    "api:check": "openapi-typescript ../接口契约/openapi.yaml -o src/api/openapi.generated.ts --check",
    "test": "tsx --test src/api/client-contract.test.mjs src/features/model-pool/modelPoolIdempotency.test.mjs src/features/auth/session.test.mjs src/features/auth/login.test.mjs src/features/activation-codes/activationCodeExpiry.test.mjs src/features/admin-rbac/adminRbac.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.0.0",
    "antd": "^5.0.0",
    "dayjs": "1.11.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "openapi-typescript": "7.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
