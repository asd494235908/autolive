# Operating system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local secrets and environment overrides
.env
.env.*
!.env.example

# Legacy fixed-phrase artifacts may still exist on developer machines after migration.
# New builds never read these paths; remove the local copies with an explicit cleanup.
.venv-voice-clone/
desktop/tools/.venv/
desktop/tools/__pycache__/
build/autolive-voice-clone-worker/
desktop/src-tauri/voice-models/
desktop/src-tauri/voice-worker/
desktop/voice-models/

# Python runtime caches
**/__pycache__/
*.py[cod]

# JavaScript dependencies and package-manager state
node_modules/
.pnpm-store/

# Frontend build output and test coverage
**/dist/
**/coverage/

# Rust/Tauri build output
**/target/
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitignore

# Locally prepared third-party FFmpeg binaries; sources and license notes stay tracked.
desktop/third_party/ffmpeg/*/ffmpeg
desktop/third_party/ffmpeg/*/ffprobe
desktop/third_party/ffmpeg/*/ffmpeg.exe
desktop/third_party/ffmpeg/*/ffprobe.exe
desktop/third_party/mpv/*/mpv.exe
desktop/third_party/mpv/*/d3dcompiler_43.dll
artifacts/
desktop/third_party/mpv/build-evidence/
desktop/third_party/mpv/build-inputs/
desktop/src-tauri/runtime-resources.json
desktop/src-tauri/embedded-runtime-resources/
!desktop/src-tauri/embedded-runtime-resources/.gitkeep
desktop/resource-release/

# Local backend binaries and runtime data
backend/bin/
backend/migrate
backend/*.db
backend/*.sqlite
backend/*.sqlite3
deploy/data/

# Tauri bundles and installers
desktop/package/
desktop/package-smoke/
desktop/package-test/
desktop/.codex-worker-smoke/
desktop/src-tauri/target-test-package/
desktop/src-tauri/bundle/
desktop/src-tauri/*.dmg
desktop/src-tauri/*.msi
desktop/src-tauri/*.exe
desktop/src-tauri/*.AppImage

# Local agent state and user-provided audio samples
.superpowers/
音频/
音频.zip
