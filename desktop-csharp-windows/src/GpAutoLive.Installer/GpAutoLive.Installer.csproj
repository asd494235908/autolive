<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GpAutoLive.Setup</AssemblyName>
    <RootNamespace>GpAutoLive.Installer</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>GpAutoLive.Installer.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\csharp-windows-install-transaction-lock.ps1" Link="tools\csharp-windows-install-transaction-lock.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\bootstrap-csharp-windows-runtime.ps1" Link="tools\bootstrap-csharp-windows-runtime.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\get-csharp-windows-install-state.ps1" Link="tools\get-csharp-windows-install-state.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\install-csharp-windows-package.ps1" Link="tools\install-csharp-windows-package.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\rollback-csharp-windows-package.ps1" Link="tools\rollback-csharp-windows-package.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\uninstall-csharp-windows-package.ps1" Link="tools\uninstall-csharp-windows-package.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\verify-release-package.ps1" Link="tools\verify-release-package.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
