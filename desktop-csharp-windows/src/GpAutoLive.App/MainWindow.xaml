<Window x:Class="GpAutoLive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:auth="clr-namespace:GpAutoLive.App.Features.Auth"
        Title="GpAutoLive"
        Icon="/GpAutoLive;component/Assets/app-icon.ico"
        Width="1586"
        Height="992"
        MinWidth="1280"
        MinHeight="800"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="53" />
            <RowDefinition Height="*" />
            <RowDefinition Height="74" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <!-- 45px custom title bar. It is the only drag surface in this shell. -->
        <Border Grid.Row="0"
                Background="#080F15"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="26"
                        Height="26"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="#101827"
                        CornerRadius="6">
                    <Image Width="26"
                           Height="26"
                           Source="/GpAutoLive;component/Assets/app-icon.png"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <TextBlock Grid.Column="1"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="GpAutoLive" />
                <Border Grid.Column="2"
                        Margin="63,0,60,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="14"
                              Height="16"
                              Margin="0,0,8,0">
                            <Path Fill="{Binding Foreground, ElementName=DeviceStatusText}"
                                  Data="M7,0 L13,2.6 V7.1 C13,11 10.5,14 7,16 C3.5,14 1,11 1,7.1 V2.6 Z" />
                            <Path Stroke="{StaticResource WindowBrush}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M4,8 L6.2,10.2 L10.4,5.8" />
                        </Grid>
                        <TextBlock x:Name="DeviceStatusText"
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="11"
                                   Text="设备未授权" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="AccountStatusText"
                           Grid.Column="3"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="账户：—" />
                <TextBlock x:Name="ActivationExpiryText"
                           Grid.Column="4"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="授权到期：—" />
                <TextBlock x:Name="PerformanceText"
                           Grid.Column="6"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Text="CPU / GPU / RAM · 待采样" />
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="AuthStatusText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               Text="未登录"
                               Visibility="Collapsed" />
                </StackPanel>
                <StackPanel Grid.Column="8" Orientation="Horizontal">
                    <Button x:Name="SettingsButton"
                            Width="64"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="打开设置"
                            Click="SettingsButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="设置 (Ctrl+,)">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14"
                                  Height="14"
                                  Margin="0,0,5,0"
                                  VerticalAlignment="Center"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.15"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="{StaticResource SettingsGearIconGeometry}" />
                            <TextBlock VerticalAlignment="Center" Text="设置" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="最小化"
                            Content="—"
                            Click="MinimizeButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="最小化" />
                    <Button Margin="4,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="最大化或还原"
                            Content="□"
                            Click="MaximizeButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="最大化/还原" />
                    <Button Margin="4,0,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="关闭"
                            Content="×"
                            Click="CloseButton_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 53px navigation and operation bar matching the reference workbench. -->
        <Border x:Name="OperationBar"
                Grid.Row="1"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="70" Height="36" Content="主页" Style="{StaticResource AccentTabButtonStyle}" />
                    <Button Width="68" Height="36" Margin="6,0,0,0" Content="工作区" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}" Style="{StaticResource TabButtonStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TopImportButton"
                            Width="110"
                            Height="36"
                            AutomationProperties.Name="添加媒体"
                            AutomationProperties.AutomationId="TopImportButton"
                            Click="ImportButton_Click"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource ButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,1 V11 M1,6 H11" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="添加媒体" />
                        </StackPanel>
                    </Button>
                    <Button Width="102" Height="36" Margin="10,0,0,0" HorizontalContentAlignment="Center" IsEnabled="False" Style="{StaticResource ButtonStyle}" ToolTip="整理媒体尚未接入；请使用媒体池下方的排序按钮">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Data="M1,1 H5 V5 H1 Z M8,1 H12 V5 H8 Z M1,8 H5 V12 H1 Z M8,8 H12 V12 H8 Z" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="整理媒体" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="TopImportPlaylistButton"
                            Width="100"
                            Height="36"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="导入媒体列表"
                            AutomationProperties.AutomationId="TopImportPlaylistButton"
                            Click="ImportPlaylistButton_Click"
                            HorizontalContentAlignment="Center"
                            IsEnabled="False"
                            Style="{StaticResource ButtonStyle}"
                            ToolTip="导入版本化 JSON 媒体列表；成功后按列表顺序替换当前播放池">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M2,1 H11 V12 H2 Z M4,4 H9 M4,7 H9 M4,10 H7" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="导入列表" />
                        </StackPanel>
                    </Button>
                    <Button Width="98" Height="36" Margin="10,0,0,0" HorizontalContentAlignment="Center" IsEnabled="False" Style="{StaticResource ButtonStyle}" ToolTip="保存配置尚未接入；媒体池仅存在当前进程">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M2,1 H10 L12,3 V12 H2 Z M4,1 V5 H9 V1 M4,8 H10 V12 H4 Z" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="保存配置" />
                        </StackPanel>
                    </Button>
                    <Button Width="100" Height="36" Margin="10,0,0,0" HorizontalContentAlignment="Center" IsEnabled="False" Style="{StaticResource ButtonStyle}" ToolTip="加载配置尚未接入；请使用添加媒体导入视频/音频文件">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M2,1 H10 L12,3 V12 H2 Z M4,9 H10 M7,11 V5 M5,7 L7,5 L9,7" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="加载配置" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="118"
                            Height="36"
                            AutomationProperties.Name="开始 RTMP 画面推流"
                            Click="StartRtmpButton_Click"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M1,2 H8 V10 H1 Z M8,4 L12,2 V10 L8,8 Z" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="开始推流" />
                        </StackPanel>
                    </Button>
                    <Button Width="146"
                            Height="36"
                            Margin="10,0,0,0"
                            AutomationProperties.Name="打开最终效果窗口"
                            Click="OpenFinalEffectButton_Click"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource ButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6.5,1 A5.5,5.5 0 1 1 6.49,1 M6.5,3.5 V6.5 L9,8" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="打开效果窗口" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MainMenuButton"
                            Height="36"
                            Margin="51,0,0,0"
                            AutomationProperties.Name="打开主菜单"
                            Content="☰"
                            Style="{StaticResource IconButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="LogoutMenuItem"
                                          Header="退出登录"
                                          Click="LogoutButton_Click"
                                          IsEnabled="False"
                                          ToolTip="退出当前登录或离线会话" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkbenchSurface" Grid.Row="2" Margin="10,9,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="23.2*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="50.3*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="26.5*" />
            </Grid.ColumnDefinitions>

            <!-- Media pool and playback settings -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="224" />
                </Grid.RowDefinitions>
            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}"
                    Padding="0"
                    AllowDrop="True"
                    DragOver="MediaPool_DragOver"
                    Drop="MediaPool_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="70" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="102" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="164" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Text="媒体池" />
                        <ComboBox Grid.Row="0" Grid.Column="2" Width="102" Height="30" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="全部" />
                            <ComboBoxItem Content="视频" />
                            <ComboBoxItem Content="音频" />
                        </ComboBox>
                        <Grid Grid.Row="0"
                              Grid.Column="4"
                              Height="30"
                              VerticalAlignment="Center">
                            <TextBox x:Name="MediaSearchTextBox"
                                     AutomationProperties.Name="搜索媒体"
                                     Padding="30,0,8,0"
                                     Text="{Binding MediaSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     TextChanged="MediaSearchTextBox_TextChanged"
                                     ToolTip="按文件名或媒体类型搜索" />
                            <Path Width="13"
                                  Height="13"
                                  Margin="10,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Data="M5.5,1 A4.5,4.5 0 1 0 5.5,10 A4.5,4.5 0 1 0 5.5,1 M8.8,8.8 L12.5,12.5"
                                  IsHitTestVisible="False"
                                  Stroke="{StaticResource MutedTextBrush}"
                                  StrokeThickness="1.2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <TextBlock x:Name="MediaSearchPlaceholderText"
                                       Margin="30,0,8,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       IsHitTestVisible="False"
                                       Text="搜索媒体">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=MediaSearchTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock x:Name="MediaCountText"
                                   Grid.Row="1"
                                   Grid.ColumnSpan="7"
                                   Margin="0,0,0,2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="10"
                                   Text="共 0 个媒体" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="10,8">
                        <StackPanel x:Name="EmptyMediaPanel" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="26"
                                       Text="＋" />
                             <TextBlock x:Name="EmptyMediaTitleText"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource MutedTextBrush}"
                                        Text="尚未添加媒体" />
                             <TextBlock x:Name="EmptyMediaHintText"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        Foreground="#697186"
                                       FontSize="11"
                                       Text="拖放文件，或使用 Ctrl+O 导入" />
                        </StackPanel>
                        <ListBox x:Name="MediaListBox"
                                 AutomationProperties.Name="有序媒体播放池"
                                 ItemsSource="{Binding VisibleMediaItems}"
                                 SelectionChanged="MediaListBox_SelectionChanged"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 Padding="0"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4" Margin="-2,0,2,9" Background="#171B25" CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="104" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="96"
                                                    Height="54"
                                                    Background="#202A39"
                                                    BorderBrush="#2B3342"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    ToolTip="{Binding MediaKindLabel}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="22"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               Text="▶">
                                                       <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="▶" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                     <Style.Triggers>
                                                                     <DataTrigger Binding="{Binding MediaKind}" Value="Video">
                                                                         <Setter Property="Visibility" Value="Visible" />
                                                                     </DataTrigger>
                                                                     <DataTrigger Binding="{Binding MediaKind}" Value="Audio">
                                                                         <Setter Property="Text" Value="♫" />
                                                                     </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="7,0,6,0">
                                                <TextBlock Foreground="{StaticResource TextBrush}" Text="{Binding FileName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10">
                                                    <Run Text="{Binding DurationLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaKind}" Value="Audio">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding VideoFormatLabel, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MediaKind}" Value="Audio">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding AudioFormatLabel, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="2" Margin="14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <Button x:Name="ImportButton"
                                AutomationProperties.Name="导入媒体"
                                Click="ImportButton_Click"
                                Height="32"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12"
                                      Height="12"
                                      VerticalAlignment="Center"
                                      Data="M6,1 V11 M1,6 H11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="导入媒体" />
                                <TextBlock Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Opacity="0.85"
                                           Text="Ctrl+O" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button x:Name="MoveUpButton"
                                    Width="52"
                                    AutomationProperties.Name="上移媒体"
                                    Content="↑"
                                    Click="MoveUpButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="上移选中媒体" />
                            <Button x:Name="MoveDownButton"
                                    Width="52"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="下移媒体"
                                    Content="↓"
                                    Click="MoveDownButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="下移选中媒体" />
                            <Button x:Name="RemoveMediaButton"
                                    Width="52"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="移除媒体"
                                    Content="移除"
                                    Click="RemoveMediaButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ButtonStyle}"
                                    ToolTip="移除选中媒体" />
                            <Button x:Name="ClearMediaButton"
                                    Width="52"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="清空媒体池"
                                    Content="清空"
                                    Click="ClearMediaButton_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ButtonStyle}"
                                    ToolTip="清空媒体池" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="播放设置（本地有序循环）" />
                        <Border HorizontalAlignment="Right" Style="{StaticResource PillStyle}">
                            <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Text="已就绪" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource SectionLabelStyle}" Text="触发方式" />
