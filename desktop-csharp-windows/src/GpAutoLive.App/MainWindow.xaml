                                                IsEnabled="False"
                                                Style="{StaticResource ButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="FixedSpeechStatusText"
                                               Margin="0,5,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               MaxHeight="18"
                                               Text="本地 SAPI 待机；不调用模型"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="抖音 M1" />
                                    <CheckBox x:Name="DouyinEnabledCheckBox"
                                              Margin="0,5,0,0"
                                              AutomationProperties.Name="启用抖音 M1 自动回应"
