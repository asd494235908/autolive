                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <Button x:Name="StartDouyinButton"
                                                Width="92"
                                                AutomationProperties.Name="启动抖音 M1 本地状态"
                                                Content="启动 M1"
                                                Click="StartDouyinButton_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                ToolTip="只启动本地状态合同，不登录或连接抖音" />
                                        <Button x:Name="PauseDouyinButton"
                                                Width="64"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="暂停抖音 M1 队列"
