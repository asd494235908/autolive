                                                Click="PauseDouyinButton_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource ButtonStyle}" />
                                        <Button x:Name="ResumeDouyinButton"
                                                Width="64"
                                                Margin="6,0,0,0"
                                                AutomationProperties.Name="恢复抖音 M1 队列"
                                                Content="恢复"
                                                Click="ResumeDouyinButton_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource ButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="DouyinStatusText"
                                               Margin="0,5,0,0"
                                               Foreground="#697186"
                                               FontSize="10"
                                               MaxHeight="18"
                                               Text="M1 本地合同已接入 · 未启动；扫码/sidecar 待验收"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Expander>
                            <Expander Margin="0,0,0,8"
                                      Padding="10"
                                      Background="{StaticResource SurfaceBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      BorderThickness="1"
                                      Header="插话文件池（高级）"
                                      IsExpanded="False">
                                <StackPanel>
                                    <TextBlock Margin="0,12,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="插话文件池（递归扫描）"
                                               Visibility="Collapsed" />
                                    <TextBox x:Name="InterludeDirectoryTextBox"
                                             Margin="0,6,0,0"
                                             AutomationProperties.Name="插话文件目录"
                                             IsReadOnly="True"
                                             MaxLength="4096"
                                             ToolTip="仅显示当前进程内存中的规范化目录，不写入普通配置"
                                             TextWrapping="NoWrap" />
                                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                        <Button x:Name="SelectInterludeDirectoryButton"
                                                Width="92"
                                                AutomationProperties.Name="选择插话文件目录"
                                                Content="选择目录"
                                                Click="SelectInterludeDirectoryButton_Click"
                                                Style="{StaticResource ButtonStyle}" />
                                        <Button x:Name="ClearInterludePoolButton"
                                                Width="64"
                                                Margin="8,0,0,0"
                                                AutomationProperties.Name="清空插话文件池"
                                                Content="清空"
                                                Click="ClearInterludePoolButton_Click"
                                                Style="{StaticResource ButtonStyle}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                        <Button x:Name="PlayInterludeButton"
                                                Width="88"
                                                AutomationProperties.Name="播放插话文件"
                                                Content="插话试播"
                                                Click="PlayInterludeButton_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        <Button x:Name="StopInterludeButton"
                                                Width="64"
                                                Margin="8,0,0,0"
                                                AutomationProperties.Name="停止插话文件"
                                                Content="停插话"
                                                Click="StopInterludeButton_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource ButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock x:Name="InterludePoolStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="未配置；不会启动解码或音频流"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="InterludeAudioConfigStatusText"
                                               Margin="0,4,0,0"
                                               Foreground="#697186"
                                               FontSize="10"
                                               Text="预设：随机 p01–p20 · 多轨关闭 · duck -60 dB"
                                               TextWrapping="Wrap" />
                                    <TextBlock Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="11"
                                               Text="PortAudio 输出设备" />
                                    <ComboBox x:Name="AudioOutputDeviceComboBox"
                                              Margin="0,6,0,0"
                                              AutomationProperties.Name="PortAudio 输出设备"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Index"
                                              IsEnabled="False" />
                                    <Button x:Name="RefreshAudioDevicesButton"
                                            Margin="0,6,0,0"
                                            AutomationProperties.Name="刷新本机音频设备"
                                            Content="刷新本机设备"
                                            Click="RefreshAudioDevicesButton_Click"
                                            Style="{StaticResource ButtonStyle}" />
                                    <TextBlock x:Name="AudioDeviceStatusText"
                                               Margin="0,6,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10"
                                               Text="尚未枚举；不启动播放流"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                             </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="运行资源" />
                            <TextBlock Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="外置 DLL / sidecar" />
                            <TextBlock x:Name="MediaResourceText" Margin="0,4,0,0" Foreground="#697186" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock x:Name="WindowsStatusText" Margin="0,8,0,0" Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" />
                            <TextBlock x:Name="MediaStatusText" Margin="0,4,0,0" Foreground="{StaticResource WarningBrush}" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Expander Margin="0,0,0,8"
                              Padding="10"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Header="RTMP 输出选项（高级）"
                              IsExpanded="False">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="RtmpVideoCheckBox"
                                          AutomationProperties.Name="RTMP 画面轨道"
                                          Content="画面"
                                          IsChecked="True" />
                                <CheckBox x:Name="RtmpAudioCheckBox"
                                          Margin="14,0,0,0"
                                          AutomationProperties.Name="RTMP 声音轨道"
                                          Content="声音"
                                          IsChecked="True" />
                            </StackPanel>
                            <Button Margin="0,5,0,0"
                                    AutomationProperties.Name="校验 RTMP 输出配置"
                                    Content="校验输出配置"
                                    Click="OutputButton_Click"
                                    Style="{StaticResource ButtonStyle}" />
                        </StackPanel>
                    </Expander>
                    <Expander Margin="0,0,0,8"
                              Padding="10"
                              Background="{StaticResource SurfaceBrush}"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Header="抖音本地回复池（高级）"
                              IsExpanded="False">
                        <StackPanel>
                            <TextBox x:Name="DouyinRepliesTextBox"
                                     Margin="0,6,0,0"
                                     MinHeight="46"
                                     AcceptsReturn="True"
                                     AutomationProperties.Name="抖音本地回复池"
                                     MaxLength="4096"
                                     Text="GpAutoLive探针✅"
                                     ToolTip="每行一条；最多 100 条，正文只保留在本地进程"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DouyinQueueCapacityTextBox"
                                         AutomationProperties.Name="抖音回复队列容量"
                                         MaxLength="4"
                                         Text="500"
                                         ToolTip="10～5000；监听中需先暂停才能修改" />
                                <TextBlock Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="10"
                                           Text="队列容量" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Playback bar -->
        <Border x:Name="PlaybackBar"
                Grid.Row="3"
                Margin="10,0"
                 Background="#131B24"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="126" />
                    <ColumnDefinition Width="308" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="82" Height="48" AutomationProperties.Name="播放或暂停" Click="PlayPauseButton_Click" HorizontalContentAlignment="Center" Style="{StaticResource AccentButtonStyle}" ToolTip="播放/暂停 (Space)"><StackPanel Orientation="Horizontal"><Path Width="12" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1 L12,7 L1,13 Z" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" Text="播放" /></StackPanel></Button>
                <Button Grid.Column="1" Width="82" Height="48" Margin="8,0,0,0" AutomationProperties.Name="暂停播放" Background="#101820" Click="PlayPauseButton_Click" HorizontalContentAlignment="Center" Style="{StaticResource ButtonStyle}" ToolTip="播放/暂停 (Space)"><StackPanel Orientation="Horizontal"><Path Width="10" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" Data="M2,1 V13 M8,1 V13" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" Text="暂停" /></StackPanel></Button>
                <Button Grid.Column="2" Width="82" Height="48" Margin="8,0,0,0" AutomationProperties.Name="停止播放" Background="#101820" Click="StopButton_Click" HorizontalContentAlignment="Center" Style="{StaticResource IconButtonStyle}" ToolTip="停止 (Ctrl+Shift+S)"><StackPanel Orientation="Horizontal"><Path Width="12" Height="12" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1 H11 V11 H1 Z" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" Text="停止" /></StackPanel></Button>
                <Button Grid.Column="3" Width="88" Height="48" Margin="8,0,0,0" AutomationProperties.Name="上一项" Background="#101820" Click="PreviousButton_Click" HorizontalContentAlignment="Center" Style="{StaticResource ButtonStyle}" ToolTip="上一项"><StackPanel Orientation="Horizontal"><Path Width="13" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M3,1 V13 M12,1 L5,7 L12,13" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" Text="上一条" /></StackPanel></Button>
                <Button Grid.Column="4" Width="88" Height="48" Margin="10,0,0,0" AutomationProperties.Name="下一项" Background="#101820" Click="NextButton_Click" HorizontalContentAlignment="Center" Style="{StaticResource ButtonStyle}" ToolTip="下一项"><StackPanel Orientation="Horizontal"><Path Width="13" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" StrokeLineJoin="Round" Data="M10,1 V13 M1,1 L8,7 L1,13" /><TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" Text="下一条" /></StackPanel></Button>
                <Grid Grid.Column="5" Margin="18,0,12,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="CurrentMediaBarText"
                               Margin="4,0,0,9"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="10"
                               VerticalAlignment="Bottom"
                               Text="当前媒体：无活动源"
                               TextTrimming="CharacterEllipsis" />
                    <Grid Grid.Row="1">
                        <Slider x:Name="PlaybackSlider"
                                Width="320"
                                Height="20"
                                Margin="3,3,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Maximum="1"
                                Value="{Binding PlaybackProgress, Mode=TwoWay}"
                                AutomationProperties.Name="播放进度"
                                PreviewMouseLeftButtonUp="PlaybackSlider_PreviewMouseLeftButtonUp"
                                KeyUp="PlaybackSlider_KeyUp" />
                        <StackPanel Margin="345,4,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                            <TextBlock x:Name="PlaybackPositionText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Text="00:00" />
                            <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Text=" / " />
                            <TextBlock x:Name="PlaybackDurationText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="10"
                                       Text="00:00" />
                        </StackPanel>
                    </Grid>
                </Grid>
                <Border Grid.Column="6" Width="1" Height="48" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{StaticResource BorderBrush}" />
                <CheckBox Grid.Column="7" Width="118" Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="播放时启用视频处理" AutomationProperties.AutomationId="VideoProcessingCheckBox" IsChecked="{Binding VideoProcessing, Mode=TwoWay}" Style="{StaticResource SwitchCheckBoxStyle}" ToolTip="视频处理">
                    <StackPanel Width="60">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="视频处理" />
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Text="{Binding VideoProcessingLabel, Mode=OneWay}" />
                    </StackPanel>
                </CheckBox>
                    <CheckBox Grid.Column="8" Width="118" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="播放时启用声音处理" AutomationProperties.AutomationId="AudioProcessingCheckBox" IsChecked="{Binding AudioProcessing, Mode=TwoWay}" Style="{StaticResource SwitchCheckBoxStyle}" ToolTip="声音处理">
                    <StackPanel Width="60">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="声音处理" />
                        <TextBlock Foreground="{StaticResource AccentBrush}" FontSize="10" Text="{Binding AudioProcessingLabel, Mode=OneWay}" />
                    </StackPanel>
                </CheckBox>
                <StackPanel Grid.Column="9" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Text="音量" />
                    <Slider x:Name="OutputVolumeSlider"
                            Width="120"
                            Maximum="100"
                            Value="80"
                            AutomationProperties.Name="输出音量"
                            ToolTip="实时作用于本机 PortAudio 和 RTMP PCM 总线"
                            ValueChanged="OutputVolumeSlider_ValueChanged" />
                    <TextBlock x:Name="OutputVolumeText" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" FontSize="10" Text="80%" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- LoginView is a gate only; it does not start media or own credentials. -->
        <auth:LoginView x:Name="LoginGate"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Panel.ZIndex="100"
                        Visibility="Visible" />

        <Border Grid.Row="4"
                Background="#101720"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0"
                IsHitTestVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="10"
                           Text="{Binding StatusMessage, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="丢帧 — (—)" />
                    <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource BorderBrush}" FontSize="10" Text="|" />
                    <TextBlock x:Name="FooterPerformanceText"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="10"
                               Text="CPU / GPU / RAM · 待采样"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="16,0" VerticalAlignment="Center" Foreground="{StaticResource BorderBrush}" FontSize="10" Text="|" />
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Text="上行 —" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="10"
                           Text="网络状态 · 待检查" />
            </Grid>
        </Border>
    </Grid>
</Window>
