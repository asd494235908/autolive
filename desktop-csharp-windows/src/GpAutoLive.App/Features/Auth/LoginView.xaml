<UserControl x:Class="GpAutoLive.App.Features.Auth.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#E8101217"
             Loaded="LoginView_Loaded"
             KeyboardNavigation.TabNavigation="Local">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Border Width="430"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Text="进入 GpAutoLive" />
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,22"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           Text="Windows 本地工作台 · 登录门禁"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="2"
                            Grid.RowSpan="4"
                            Visibility="{Binding IsCredentialEntryVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="账号" />
                    <TextBox x:Name="AccountBox"
                             Height="36"
                             Margin="0,6,0,14"
                             MaxLength="128"
                             MinHeight="36"
                             TabIndex="1"
                             Text="{Binding Account, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="账号" />

                    <TextBlock Style="{StaticResource SectionLabelStyle}" Text="密码" />
                    <PasswordBox x:Name="PasswordBox"
                                 Height="36"
                                 Margin="0,6,0,10"
                                 MaxLength="256"
                                 MinHeight="36"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 TabIndex="2"
                                 AutomationProperties.Name="密码"
                                 AutomationProperties.HelpText="密码只在当前进程内暂存，不写入配置文件。" />
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               MinHeight="36"
                               Margin="0,4,0,12"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="11"
                               Text="{Binding Message}"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite" />
                    <Button Grid.Row="1"
                            Height="34"
                            MinHeight="34"
                            Margin="0,0,0,8"
                            IsDefault="True"
                            IsEnabled="{Binding CanSubmit}"
                            Visibility="{Binding IsCredentialEntryVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            TabIndex="3"
                            Content="登录"
                            Click="LoginButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource AccentButtonStyle}"
                            AutomationProperties.Name="登录" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Width="Auto"
                                Height="30"
                                MinHeight="30"
                                Margin="0,0,8,0"
                                IsEnabled="{Binding CanRefresh}"
                                TabIndex="4"
                                Content="重试设备授权"
                                Click="RefreshButton_Click"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource ButtonStyle}"
                                AutomationProperties.Name="重试设备授权" />
                        <Button Height="30"
                                MinHeight="30"
                                IsEnabled="{Binding CanUseOffline}"
                                TabIndex="5"
                                Content="离线续播（需已授权）"
                                Click="OfflineButton_Click"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource ButtonStyle}"
                                AutomationProperties.Name="进入离线续播模式" />
                    </StackPanel>
                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Foreground="#697186"
                               FontSize="10"
                               Text="离线续播只适用于已授权会话的网络中断，不能绕过登录或设备激活。"
                               TextWrapping="Wrap" />
                    <Button Grid.Row="4"
                            Height="30"
                            MinHeight="30"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            IsEnabled="{Binding IsGateVisible}"
                            TabIndex="6"
                            Content="设备需要激活？"
                            Click="ActivationButton_Click"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Style="{StaticResource ButtonStyle}"
                            AutomationProperties.Name="显示设备激活提示" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
