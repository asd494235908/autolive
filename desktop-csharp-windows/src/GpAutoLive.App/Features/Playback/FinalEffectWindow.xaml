<Window x:Class="GpAutoLive.App.Features.Playback.FinalEffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:GpAutoLive.App.Features.Playback"
        Title="GpAutoLive · 最终效果"
        Icon="/GpAutoLive;component/Assets/app-icon.ico"
        Width="960"
        Height="600"
        MinWidth="640"
        MinHeight="420"
        Background="Black"
        Foreground="White"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="56" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Black">
            <playback:ReservedVideoSurface x:Name="VideoSurface" />
            <Border x:Name="AudioSurface" Background="Black" Visibility="Collapsed" />
            <StackPanel x:Name="EmptySurface" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Text="等待播放" />
                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Center"
                           Foreground="#AAB2C5"
                           FontSize="12"
                           Text="由主窗口控制播放；未校验资源时不会启动媒体进程" />
            </StackPanel>
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="16"
                    Background="#CC171A22"
                    CornerRadius="4"
                    Padding="10,6">
                <TextBlock x:Name="SurfaceModeText" FontSize="11" Text="无活动媒体" />
            </Border>
        </Grid>

        <Border x:Name="Footer"
                Grid.Row="1"
                Panel.ZIndex="10"
                Background="#171A22"
                BorderBrush="#2B3040"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="PlayPauseButton"
                        Width="96"
                        Margin="0,0,8,0"
                        AutomationProperties.Name="最终效果播放或暂停"
                        Content="播放/暂停"
                        Click="PlayPauseButton_Click" />
                <Button Grid.Column="1"
                        x:Name="StopButton"
                        Width="64"
                        AutomationProperties.Name="最终效果停止"
                        Content="停止"
                        Click="StopButton_Click" />
                <StackPanel Grid.Column="2" Margin="16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="PlaybackStateText" FontSize="12" Text="已停止" />
                    <ProgressBar x:Name="PlaybackProgress" Height="4" Margin="0,6,0,0" Maximum="1" />
                </StackPanel>
                <TextBlock Grid.Column="3"
                           x:Name="IdentityText"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           Foreground="#929AAF"
                           FontSize="10"
                           Text="会话 0 · 源 0" />
                <Button Grid.Column="4"
                        x:Name="CloseButton"
                        Width="64"
                        AutomationProperties.Name="关闭最终效果窗口"
                        Content="关闭"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
