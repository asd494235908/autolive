<Window x:Class="GpAutoLive.App.Features.Playback.FinalEffectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:playback="clr-namespace:GpAutoLive.App.Features.Playback"
        Title="GpAutoLive 最终效果"
        Icon="/GpAutoLive;component/Assets/app-icon.ico"
        Width="1280"
        Height="720"
        MinWidth="320"
        MinHeight="180"
        Background="Black"
        Foreground="White"
        ShowInTaskbar="False"
        ShowActivated="True"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closed="Window_Closed">
    <Grid Background="Black">
        <Border Background="Black" MinWidth="1" MinHeight="1" />
        <playback:ReservedVideoSurface x:Name="VideoSurface" />
        <Border x:Name="AudioSurface" Background="Black" Visibility="Collapsed" />
    </Grid>
</Window>
