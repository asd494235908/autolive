AUTOLIVE_API_IMAGE=autolive-api:20260814-01
AUTOLIVE_ADMIN_IMAGE=autolive-admin:20260814-01
# The compose HTTP hop is loopback-only; expose HTTPS from the host reverse proxy.
AUTOLIVE_ADMIN_HTTP_BIND=127.0.0.1

APP_ADDR=:8080
APP_VERSION=20260814-01
# Production is normalized-only. Apply migrations, run the one-time backfill,
# and pass the read-only cutover preflight before starting the API.
APP_STORAGE_MODE=postgres
# Run with APP_NORMALIZED_BACKFILL_CONFIRM=YES:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml run --rm -e APP_NORMALIZED_BACKFILL_CONFIRM=YES autolive-api /usr/local/bin/autolive-backfill-normalized
# Before a production switch, run the read-only cutover preflight:
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml run --rm -e APP_MODEL_READ_SOURCE=normalized -e APP_NORMALIZED_CUTOVER_CONFIRM=YES autolive-api /usr/local/bin/autolive-verify-normalized-cutover
# The API refuses normalized mode while migration 0020 reports a pending backfill marker.
APP_MODEL_READ_SOURCE=normalized
APP_DEPLOYMENT_ENV=production
# Replace admin.example.com with the DNS name present in the host certificate and Tauri capability.
APP_PUBLIC_BASE_URL=https://admin.example.com
APP_ALLOW_INSECURE_HTTP=false
APP_DATABASE_URL=postgres://autolive_app:REPLACE_ON_SERVER@postgres-shared:5432/autolive_control_plane?sslmode=disable
APP_SECRET_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Independent 32-byte HMAC key for privacy-preserving account/IP login buckets.
APP_AUTH_THROTTLE_HMAC_KEY=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For; leave empty
# when the API receives client connections directly.
APP_TRUSTED_PROXY_CIDRS=
# PostgreSQL first bootstrap rejects REPLACE_WITH_ placeholders; replace both values before the first deployment.
# After the local admin changes its password through the admin API, both variables may be omitted on restart.
APP_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
APP_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
# Bounds HTTP handling and PostgreSQL Repository/session/Secret Store operations.
APP_REQUEST_TIMEOUT=30s
# Allows in-flight requests and bounded background tasks to finish on SIGTERM.
APP_SHUTDOWN_TIMEOUT=45s
# Independent budget for the one-shot migration container.
APP_MIGRATION_TIMEOUT=30s
# Optional Prometheus textfile snapshot written by the one-shot migration
# container. Leave empty to preserve the default; when enabled, mount the
# parent directory into autolive-migrate and let the textfile collector read it.
APP_MIGRATION_METRICS_FILE=
APP_MODEL_HEALTH_PROBE_INTERVAL=5m
APP_MODEL_HEALTH_PROBE_TIMEOUT=10s
APP_MODEL_HEALTH_PROBE_MAX_CONCURRENT=2
APP_MODEL_HEALTH_PROBE_MAX_ACCOUNTS=50
APP_MODEL_HEALTH_PROBE_BACKOFF_BASE=30s
APP_MODEL_HEALTH_PROBE_BACKOFF_MAX=15m
# Bounded background retention cleanup; set interval to 0 to disable.
APP_RETENTION_CLEANUP_INTERVAL=1h
APP_RETENTION_CLEANUP_TIMEOUT=30s
APP_RETENTION_CLEANUP_BATCH=1000
APP_AUTH_SESSION_RETENTION_TTL=720h
APP_AUTH_THROTTLE_RETENTION_TTL=24h
APP_IDEMPOTENCY_RETENTION_TTL=720h
APP_MODEL_TEST_RETENTION_TTL=720h
APP_AUDIT_LOG_RETENTION_TTL=8760h
# Compose sends SIGTERM and waits this long before force-killing a container.
AUTOLIVE_STOP_GRACE_PERIOD=60s
